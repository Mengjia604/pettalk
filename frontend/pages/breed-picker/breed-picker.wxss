page {
  height: 100%;
  overflow: hidden;
  background: #fff;
}

.picker-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #fff;
}

.search-wrap {
  padding: 24rpx 30rpx;
  background: #fff;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #f2f4f7;
  border-radius: 38rpx;
}

.search-icon {
  position: relative;
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
  border: 3rpx solid #9aa1ab;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -6rpx;
  width: 16rpx;
  height: 3rpx;
  background: #9aa1ab;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 24rpx;
  color: #1f2329;
}

.search-clear {
  flex-shrink: 0;
  padding-left: 16rpx;
  font-size: 30rpx;
  color: #b0b6bf;
}

.columns {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-scroll {
  flex-shrink: 0;
  width: 190rpx;
  height: 100%;
  background: #f6f7f9;
}

.category-item {
  position: relative;
  height: 96rpx;
  padding-left: 34rpx;
  font-size: 27rpx;
  line-height: 96rpx;
  color: #606873;
}

.category-item.active {
  font-weight: 600;
  color: #1f2329;
  background: #fff;
}

.category-item.active::before {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 0;
  width: 6rpx;
  height: 44rpx;
  background: #f7780a;
  border-radius: 3rpx;
}

.breed-scroll {
  flex: 1;
  height: 100%;
  background: #fff;
}

.breed-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 30rpx 0 40rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f1f3f5;
}

.breed-item.active {
  background: #fff8f1;
}

.breed-name {
  flex: 1;
  font-size: 27rpx;
  color: #303540;
}

.breed-item.active .breed-name {
  font-weight: 600;
  color: #f7780a;
}

.breed-category {
  margin-left: 12rpx;
  font-size: 21rpx;
  color: #b0b6bf;
}

.breed-check {
  margin-left: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #f7780a;
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 150rpx;
}

.empty-icon {
  position: relative;
  width: 164rpx;
  height: 164rpx;
  background: #fff1e4;
  border-radius: 50%;
}

.empty-icon::before {
  content: '';
  position: absolute;
  top: 48rpx;
  left: 48rpx;
  width: 54rpx;
  height: 54rpx;
  box-sizing: border-box;
  border: 5rpx solid #f7780a;
  border-radius: 50%;
}

.empty-icon::after {
  content: '';
  position: absolute;
  top: 102rpx;
  left: 98rpx;
  width: 30rpx;
  height: 5rpx;
  background: #f7780a;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.empty-title {
  margin-top: 40rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #303540;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9aa1ab;
}

.empty-feedback {
  min-width: 224rpx;
  height: 68rpx;
  padding: 0 36rpx;
  margin-top: 46rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 68rpx;
  color: #f7780a;
  background: #fff1e4;
  border: none;
  border-radius: 34rpx;
}

.empty-feedback::after,
.footer-feedback::after {
  border: none;
}

.empty-tip {
  margin-top: 28rpx;
  font-size: 21rpx;
  color: #b0b6bf;
}

.picker-footer {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #edeff2;
}

.footer-hint {
  font-size: 22rpx;
  color: #9aa1ab;
}

.footer-feedback {
  height: 56rpx;
  padding: 0 30rpx;
  margin: 0;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 56rpx;
  color: #f7780a;
  background: #fff1e4;
  border: none;
  border-radius: 28rpx;
}
