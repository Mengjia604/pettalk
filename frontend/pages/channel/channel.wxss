page {
  background: #F4F6F8;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  background: #F4F6F8;
}

.channel-hero {
  position: relative;
  overflow: hidden;
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx 30rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  box-shadow: 0 16rpx 36rpx rgba(24, 31, 42, 0.14);
}

.hero-cat { background: linear-gradient(135deg, #F3A683, #E77F67); }
.hero-dog { background: linear-gradient(135deg, #7FB3D5, #5A8FB8); }
.hero-small-pet { background: linear-gradient(135deg, #F5CD79, #E7A93C); }
.hero-bird { background: linear-gradient(135deg, #82C9A7, #4FA37C); }
.hero-aquatic { background: linear-gradient(135deg, #74B9FF, #4A8EDB); }
.hero-reptile { background: linear-gradient(135deg, #A29BFE, #7A6FDB); }
.hero-other { background: linear-gradient(135deg, #B2BEC3, #84939B); }
.hero-cute-kid { background: linear-gradient(135deg, #F8A5C2, #E56B9F); }

.hero-orb {
  position: absolute;
  right: -80rpx;
  top: -110rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-name {
  font-size: 50rpx;
  font-weight: 700;
}

.hero-desc {
  max-width: 480rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.88);
}

.hero-paw {
  width: 92rpx;
  height: 92rpx;
  opacity: 0.5;
  filter: brightness(0) invert(1);
}

.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero-bottom {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 34rpx;
}

.hero-stat {
  display: flex;
  flex-direction: column;
}

.hero-number {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-divider {
  width: 1rpx;
  height: 44rpx;
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.30);
}

.hero-join-btn,
.hero-joined-btn {
  flex-shrink: 0;
  height: 62rpx;
  margin: 0;
  padding: 0 26rpx;
  border: none;
  border-radius: 31rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.hero-join-btn {
  background: #FFFFFF !important;
  color: #D95E85 !important;
}

.hero-joined-btn {
  background: rgba(255, 255, 255, 0.20) !important;
  color: #E5484D !important;
}

.hero-join-btn::after,
.hero-joined-btn::after {
  border: none;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2329;
}

.section-extra {
  font-size: 22rpx;
  color: #9AA0A6;
}

.feed {
  padding: 8rpx 24rpx 20rpx;
}

.post-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #74ebd5 0%, #9face6 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 80rpx;
  text-align: center;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B0B0B0;
}

.post-content {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #333333;
  word-break: break-all;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.grid-image {
  width: 206rpx;
  height: 206rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
  object-fit: cover;
}

.post-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 26rpx;
  color: #888888;
}

.stat {
  margin-left: 40rpx;
}

.stat.like.active {
  color: #4A90E2;
  font-weight: 600;
}

.share-stat {
  width: auto;
  display: flex;
  align-items: center;
  padding: 0;
  border: none;
  background: transparent;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.4;
  color: #F97316;
}

.share-stat::after {
  border: none;
}

.empty {
  padding: 100rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.empty-action {
  width: 180rpx;
  margin: 28rpx auto 0;
  padding: 16rpx 0;
  border-radius: 30rpx;
  background: #FFF1E7;
  color: #E26816;
  font-size: 26rpx;
}

.empty-tip {
  margin-top: 22rpx;
  color: #B2B8C0;
  font-size: 23rpx;
}

.loading,
.no-more {
  padding: 30rpx 0;
  color: #B0B0B0;
  font-size: 24rpx;
  text-align: center;
}

.fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FB923C, #F97316);
  box-shadow: 0 12rpx 26rpx rgba(249, 115, 22, 0.32);
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 88rpx;
  text-align: center;
}
