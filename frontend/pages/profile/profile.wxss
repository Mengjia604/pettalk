page {
  background: #ffffff;
  color: #3a302d;
}

.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.state-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 80vh;
  padding: 80rpx 60rpx;
  text-align: center;
}

.state-cat {
  width: 200rpx;
  height: 190rpx;
  margin-bottom: 24rpx;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 96rpx;
  color: #f7780a;
  background: #fff0e2;
  border-radius: 50%;
}

.state-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3a302d;
}

.state-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #9a8b84;
}

.state-btn {
  padding: 0 70rpx;
  margin-top: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff !important;
  background: linear-gradient(135deg, #ff9a44, #fc6076) !important;
  border: none;
  border-radius: 44rpx;
}

.state-btn::after {
  border: none;
}

.cover-wrap {
  position: relative;
  box-sizing: border-box;
  height: 440rpx;
  overflow: hidden;
}

.cover-image,
.cover-fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-fallback {
  overflow: hidden;
  background: linear-gradient(160deg, #fff2e2 0%, #ffdcb9 62%, #ffd0aa 100%);
}

.cover-blob {
  position: absolute;
  border-radius: 50%;
}

.blob-one {
  top: -120rpx;
  right: -90rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(255, 255, 255, 0.9);
}

.blob-two {
  bottom: -180rpx;
  left: -80rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(255, 233, 208, 0.92);
}

.cover-paw {
  position: absolute;
  width: 120rpx;
  height: 116rpx;
  opacity: 0.32;
}

.paw-one {
  top: 150rpx;
  left: 72rpx;
  transform: rotate(-12deg);
}

.paw-two {
  right: 78rpx;
  bottom: 86rpx;
  width: 96rpx;
  height: 92rpx;
  transform: rotate(15deg);
}

.cover-mask {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 190rpx;
  background: linear-gradient(180deg, rgba(58, 48, 45, 0.2), rgba(58, 48, 45, 0));
}

.nav-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 28rpx;
}

.nav-title {
  max-width: 520rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 10rpx rgba(58, 48, 45, 0.22);
  white-space: nowrap;
}

.info-card {
  position: relative;
  z-index: 3;
  padding: 0 36rpx 26rpx;
  margin-top: -84rpx;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
}

.profile-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
}

.avatar-wrap {
  flex-shrink: 0;
  margin-top: -82rpx;
}

.avatar {
  display: block;
  box-sizing: border-box;
  width: 150rpx;
  height: 150rpx;
  border: 8rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(58, 48, 45, 0.12);
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 134rpx;
  background: linear-gradient(135deg, #ff9a44, #f7780a);
}

.identity {
  flex: 1;
  min-width: 0;
  padding-bottom: 10rpx;
}

.nickname {
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 700;
  color: #3a302d;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bio {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8c7b74;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.stats {
  display: flex;
  gap: 54rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #3a302d;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8c7b74;
}

.edit-btn,
.follow-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 160rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a44, #fc6076);
  border-radius: 34rpx;
}

.follow-btn {
  color: #f7780a;
  background: #fff1e4;
  border: 1rpx solid #ffd7b8;
}

.follow-btn.followed {
  color: #a8968e;
  background: #f8f4f1;
  border-color: #f0e6df;
}

.section {
  margin-top: 22rpx;
  padding: 0 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a302d;
}

.section-link,
.section-meta {
  font-size: 21rpx;
  color: #a8968e;
}

.section-link {
  font-weight: 600;
  color: #f7780a;
}

.hscroll {
  width: 100%;
  white-space: nowrap;
}

.hscroll-inner {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.pet-card,
.channel-card {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  box-sizing: border-box;
  width: 212rpx;
  gap: 14rpx;
  padding: 18rpx 16rpx;
  background: #fff8f1;
  border-radius: 24rpx;
}

.pet-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.pet-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b85b12;
  font-size: 26rpx;
  font-weight: 700;
  background: #ffe3cb;
}

.pet-info,
.channel-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.pet-name,
.channel-name {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 600;
  color: #3a302d;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-breed,
.channel-meta {
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 19rpx;
  color: #a8968e;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.channel-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  background: #fff1e4;
  border-radius: 50%;
}

.channel-paw {
  width: 32rpx;
  height: 31rpx;
}

.empty-inline {
  padding: 28rpx 18rpx;
  font-size: 23rpx;
  color: #b85b12;
  background: #fff8f1;
  border-radius: 22rpx;
}

.feed-section {
  margin-top: 24rpx;
  border-top: 12rpx solid #faf7f4;
}

.feed-tabs {
  padding: 18rpx 30rpx 0;
}

.feed-tab {
  display: inline-block;
  padding: 18rpx 2rpx 16rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #f7780a;
  border-bottom: 6rpx solid #f7780a;
}

.feed-list {
  padding: 12rpx 24rpx 40rpx;
}

.post-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 22rpx rgba(58, 48, 45, 0.05);
}

.post-content {
  margin-bottom: 16rpx;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-all;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.grid-image {
  flex-shrink: 0;
  width: 206rpx;
  height: 206rpx;
  background: #f7f1ec;
  border-radius: 12rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  font-size: 22rpx;
  color: #a8968e;
  border-top: 1rpx solid #f5f0ec;
}

.post-stats {
  display: flex;
  gap: 20rpx;
}

.feed-empty,
.feed-loading,
.feed-no-more {
  padding: 70rpx 0;
  font-size: 25rpx;
  color: #a8968e;
  text-align: center;
}

.feed-loading,
.feed-no-more {
  padding: 26rpx 0;
  font-size: 22rpx;
  color: #b7a49c;
}
