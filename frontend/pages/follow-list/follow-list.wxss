page {
  background: #f7f3f0;
  color: #3a302d;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  padding: 12rpx 32rpx 20rpx;
  background: #f7f3f0;
}

.tab {
  position: relative;
  flex: 1;
  padding: 16rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #9a8b84;
  text-align: center;
}

.tab.active {
  font-weight: 700;
  color: #3a302d;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  width: 44rpx;
  height: 8rpx;
  background: linear-gradient(135deg, #ff9a44, #fc6076);
  border-radius: 4rpx;
  transform: translateX(-50%);
}

.user-list {
  padding: 8rpx 24rpx 0;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(89, 56, 36, 0.05);
}

.avatar {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.avatar-text {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 92rpx;
  color: #f7780a;
  text-align: center;
  background: #fff0e2;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.nickname {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  color: #3a302d;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bio {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 24rpx;
  color: #9a8b84;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9a44, #fc6076);
  border-radius: 28rpx;
}

.follow-btn.followed {
  color: #9a8b84;
  background: #f3efec;
}

.state-text,
.status-text {
  padding: 48rpx 0;
  font-size: 24rpx;
  color: #b7aaa3;
  text-align: center;
}

.state-text {
  padding-top: 160rpx;
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  text-align: center;
}

.state-cat {
  width: 200rpx;
  height: 190rpx;
  margin-bottom: 24rpx;
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a302d;
}

.state-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a8b84;
}
