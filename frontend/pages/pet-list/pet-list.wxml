<view class="pet-page">
  <view wx:if="{{needLogin}}" class="state-card">
    <view class="state-paw-wrap">
      <image class="state-paw" src="/images/paw.png" mode="aspectFit"></image>
    </view>
    <view class="state-title">登录后查看宠物档案</view>
    <view class="state-desc">登录后可以添加和管理宠物。</view>
    <button class="state-btn" bindtap="goLogin">微信一键登录</button>
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-icon">!</view>
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{loadError}}</view>
    <button class="state-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <view wx:if="{{pets.length > 0}}" class="list-header">
      <text class="list-title">我的宠物</text>
      <text class="list-count">共 {{pets.length}} 只</text>
    </view>

    <view class="pet-list">
      <view
        wx:for="{{pets}}"
        wx:key="id"
        class="pet-card"
        data-id="{{item.id}}"
        bindtap="goEdit"
      >
        <image
          wx:if="{{item.avatarUrl}}"
          class="pet-avatar"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="pet-avatar pet-avatar-empty">
          <image class="pet-paw" src="/images/paw.png" mode="aspectFit"></image>
        </view>
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.name}}</text>
            <text wx:if="{{item.breed}}" class="pet-breed">{{item.breed}}</text>
          </view>
          <text class="pet-birthday">生日 {{item.birthday || '未填写'}}</text>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>

    <view wx:if="{{loading && pets.length === 0}}" class="loading">加载中...</view>

    <view wx:if="{{!loading && pets.length === 0}}" class="empty-state">
      <view class="empty-paw-wrap">
        <image class="empty-paw" src="/images/paw.png" mode="aspectFit"></image>
      </view>
      <view class="empty-title">档案为空~</view>
      <view class="empty-desc">点击右下角按钮</view>
      <view class="empty-desc">添加我的第一只宝贝</view>
    </view>

    <view class="fab" bindtap="goAdd">
      <text class="fab-plus">+</text>
    </view>
  </block>
</view>
