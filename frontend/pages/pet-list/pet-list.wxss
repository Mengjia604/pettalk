page {
  background: #f4f6f8;
}

.pet-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 30rpx calc(200rpx + env(safe-area-inset-bottom));
}

.list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 12rpx 8rpx 22rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303540;
}

.list-count {
  font-size: 22rpx;
  color: #9aa1ab;
}

.pet-card {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  margin-bottom: 22rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 43, 61, 0.05);
}

.pet-avatar {
  flex-shrink: 0;
  width: 118rpx;
  height: 118rpx;
  background: #f0f0f0;
  border-radius: 50%;
}

.pet-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0e1;
}

.pet-paw {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.85;
}

.pet-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pet-name {
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-breed {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #f7780a;
  background: #fff1e4;
  border-radius: 18rpx;
}

.pet-birthday {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9aa1ab;
}

.chevron {
  margin-left: 12rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #c4cad1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 190rpx;
}

.empty-paw-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  background: #fff0e1;
  border-radius: 50%;
}

.empty-paw {
  width: 110rpx;
  height: 110rpx;
  opacity: 0.85;
}

.empty-title {
  margin-top: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #303540;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9aa1ab;
}

.fab {
  position: fixed;
  right: 44rpx;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #ffac56, #fc5860);
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(252, 88, 96, 0.35);
}

.fab-plus {
  padding-bottom: 6rpx;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  color: #fff;
}

.loading {
  padding: 120rpx 0;
  font-size: 26rpx;
  color: #9aa1ab;
  text-align: center;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  text-align: center;
}

.state-paw-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
  background: #fff0e1;
  border-radius: 50%;
}

.state-paw {
  width: 90rpx;
  height: 90rpx;
  opacity: 0.85;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 96rpx;
  color: #f7780a;
  background: #fff0e2;
  border-radius: 50%;
}

.state-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.state-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #999;
}

.state-btn {
  padding: 0 70rpx;
  margin-top: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff !important;
  background: linear-gradient(135deg, #ff9a44, #fc6076) !important;
  border: none;
  border-radius: 44rpx;
}

.state-btn::after {
  border: none;
}
