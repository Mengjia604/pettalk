<view class="page">
  <view class="top-bar">
    <view class="search-header">
      <view class="search-bar">
        <view class="search-icon"></view>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜索热门帖子、猫咪、狗狗…"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onSearchInput"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
          bindconfirm="onSearchConfirm"
        />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="onSearchClear">×</view>
      </view>
      <view class="search-action" catchtap="onSearchTap">搜索</view>
    </view>

    <view class="main-tabs">
      <view
        class="main-tab {{activeTab === 'hot' ? 'active' : ''}}"
        data-tab="hot"
        bindtap="switchMainTab"
      >
        <text>热门</text>
        <view wx:if="{{activeTab === 'hot'}}" class="tab-underline"></view>
      </view>
      <view
        class="main-tab {{activeTab === 'channel' ? 'active' : ''}}"
        data-tab="channel"
        bindtap="switchMainTab"
      >
        <text>频道</text>
        <view wx:if="{{activeTab === 'channel'}}" class="tab-underline"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{showSuggest}}" class="suggest-panel">
    <view class="suggest-title">热门搜索</view>
    <view class="chip-list">
      <view
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="chip {{item === activeKeyword ? 'chip-hot' : ''}}"
        data-keyword="{{item}}"
        catchtap="onHotKeywordTap"
      >{{item}}</view>
    </view>
    <view class="suggest-divider"></view>
    <view class="suggest-title suggest-title-row">
      <text>猜你喜欢</text>
      <text class="suggest-refresh" catchtap="onRecommendationRefresh">换一批</text>
    </view>
    <view
      wx:for="{{recommendations}}"
      wx:key="title"
      class="recommend-item"
      data-keyword="{{item.keyword}}"
      catchtap="onRecommendationTap"
    >
      <view class="recommend-tag">{{item.tag}}</view>
      <view class="recommend-info">
        <view class="recommend-title">{{item.title}}</view>
        <view class="recommend-meta">{{item.meta}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showSuggest}}" class="suggest-mask" catchtap="closeSuggest"></view>

  <block wx:if="{{activeTab === 'hot'}}">
    <view wx:if="{{topChannels.length > 0}}" class="home-channel-block">
      <view class="home-channel-head">
        <text class="home-channel-title">{{topChannelsTitle}}</text>
        <text class="home-channel-all" bindtap="goAllChannels">全部频道 ›</text>
      </view>
      <scroll-view class="home-channel-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{topChannels}}"
          wx:key="id"
          class="home-channel-card channel-{{item.code}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="goChannel"
        >
          <text wx:if="{{item.joined}}" class="joined-badge">已加入</text>
          <view class="home-channel-name">{{item.name}}</view>
          <view class="home-channel-desc">{{item.description}}</view>
          <view class="home-channel-meta">
            {{item.memberCount || 0}} 成员 · 今日 {{item.todayPostCount || 0}} 帖
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:elif="{{topChannelsError}}" class="home-channel-error" bindtap="loadTopChannels">
      <text>频道加载失败，点击重试</text>
    </view>

    <view class="section-head">
      <view>
        <text class="section-title">{{activeKeyword ? '搜索结果' : '热门帖子'}}</text>
        <text class="section-sub">{{activeKeyword ? '与关键词相关的帖子' : '按点赞和评论热度排序'}}</text>
      </view>
      <text class="section-extra">{{activeKeyword ? total + ' 条' : '持续更新'}}</text>
    </view>

    <view class="feed">
      <view wx:for="{{list}}" wx:key="id" class="post-card">
        <view class="post-header" data-user-id="{{item.userId}}" bindtap="goProfile">
          <image
            wx:if="{{item.avatar}}"
            class="avatar"
            src="{{item.avatar}}"
            mode="aspectFill"
          ></image>
          <view wx:else class="avatar">{{item.userId}}</view>
          <view class="user-info">
            <view class="nickname">{{item.nickname || '用户' + item.userId}}</view>
            <view class="meta-line">
              <text class="time">{{item.createdAt || ''}}</text>
              <text
                wx:if="{{item.channelName}}"
                class="channel-tag"
                data-id="{{item.channelId}}"
                data-name="{{item.channelName}}"
                catchtap="goChannel"
              >#{{item.channelName}}</text>
            </view>
          </view>
          <view
            wx:if="{{currentUserId && item.userId === currentUserId}}"
            class="post-more"
            data-id="{{item.id}}"
            catchtap="onPostMore"
          >
            <view class="post-more-dot"></view>
            <view class="post-more-dot"></view>
            <view class="post-more-dot"></view>
          </view>
        </view>

        <view
          wx:if="{{item.content}}"
          class="post-content"
          data-id="{{item.id}}"
          bindtap="goDetail"
        ><text
          wx:for="{{item.contentParts}}"
          wx:for-item="part"
          wx:key="id"
          class="{{part.highlight ? 'keyword-hit' : ''}}"
        >{{part.text}}</text></view>

        <view wx:if="{{item.images && item.images.length > 0}}" class="image-grid">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="*this"
            src="{{img}}"
            mode="aspectFill"
            data-urls="{{item.images}}"
            data-current="{{img}}"
            bindtap="previewImage"
            class="grid-image"
          ></image>
        </view>

        <view class="post-footer">
          <view
            class="stat like {{item.liked ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleLike"
          >{{item.liked ? '已赞' : '点赞'}} {{item.likeCount || 0}}</view>
          <view class="stat" data-id="{{item.id}}" bindtap="goDetail">评论 {{item.commentCount || 0}}</view>
          <button
            class="stat share-stat"
            open-type="share"
            data-post-id="{{item.id}}"
            hover-class="none"
          >转发</button>
        </view>
      </view>

      <view wx:if="{{list.length === 0 && !loading}}" class="empty">
        <text wx:if="{{activeKeyword}}">未找到与「{{activeKeyword}}」相关的内容，换个关键词试试～</text>
        <text wx:else>还没有帖子，去发布第一条吧～</text>
      </view>

      <view wx:if="{{loading}}" class="loading">加载中...</view>
      <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">— 没有更多了 —</view>
    </view>

    <view class="fab" bindtap="goPublish">+</view>
  </block>

  <block wx:elif="{{activeTab === 'channel'}}">
    <view class="channel-section">
      <view class="section-head channel-head">
        <view>
          <text class="section-title">全部频道</text>
          <text class="section-sub">按频道大类浏览，不细分品种</text>
        </view>
        <text class="section-extra">{{channels.length || 0}} 个</text>
      </view>

      <view class="channel-grid">
        <view
          wx:for="{{channels}}"
          wx:key="id"
          class="channel-card channel-{{item.code}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="goChannel"
        >
          <text wx:if="{{item.joined}}" class="joined-badge grid-joined">已加入</text>
          <view class="channel-card-top">
            <text class="channel-name">{{item.name}}</text>
            <image class="channel-paw" src="/images/paw.png" mode="aspectFit"></image>
          </view>
          <text class="channel-desc">{{item.description}}</text>
          <view class="channel-stats">
            <text>{{item.memberCount || 0}} 成员</text>
            <text>今日 {{item.todayPostCount || 0}} 帖</text>
          </view>
        </view>
      </view>

      <view wx:if="{{channelLoading}}" class="loading">加载中...</view>
      <view wx:elif="{{channels.length === 0}}" class="empty">暂无频道，请先执行 docs/sql/channel.sql</view>
      <view class="channel-tip">频道只保留大类，发布帖子时选择一个频道即可。</view>
    </view>
  </block>
</view>
