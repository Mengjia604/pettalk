page {
  background: #F4F6F8;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.detail-container {
  padding: 20rpx 24rpx;
}

.post-card,
.comment-section {
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.post-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.post-more {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #F3F5F8;
}

.post-more-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #5F6670;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #74EBD5 0%, #9FACE6 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 84rpx;
  text-align: center;
}

.avatar-image {
  display: block;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}

.meta-line {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.time {
  font-size: 22rpx;
  color: #A7ADB5;
}

.channel-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  background: #FFF3E8;
  font-size: 20rpx;
  color: #C26116;
}

.post-content {
  margin-bottom: 22rpx;
  font-size: 32rpx;
  line-height: 1.75;
  color: #2F343B;
  word-break: break-all;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.grid-image {
  width: 206rpx;
  height: 206rpx;
  border-radius: 12rpx;
  background: #F0F1F3;
}

.post-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F1F3;
  font-size: 26rpx;
  color: #8A9099;
}

.stat {
  margin-left: 40rpx;
}

.stat.like.active {
  color: #F97316;
  font-weight: 600;
}

.comment-section {
  min-height: 360rpx;
  padding: 28rpx;
}

.comment-title {
  margin-bottom: 20rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #F97316;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}

.empty-comment {
  margin-top: 70rpx;
  color: #A7ADB5;
  font-size: 26rpx;
  text-align: center;
}

.bottom-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EEF0F3;
  background: #FFFFFF;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border-radius: 35rpx;
  background: #F3F5F7;
  font-size: 27rpx;
}

.send-btn,
.share-btn {
  flex-shrink: 0;
  height: 64rpx;
  margin: 0 0 0 12rpx;
  padding: 0 24rpx;
  border: none;
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.send-btn {
  background: linear-gradient(135deg, #FF9A44, #FC6076) !important;
  color: #FFFFFF !important;
}

.share-btn {
  background: #FFF1E7 !important;
  color: #E26816 !important;
  font-weight: 600;
}

.share-btn::after,
.send-btn::after {
  border: none;
}

.btn-hover,
.share-hover {
  opacity: 0.86;
  transform: scale(0.96);
}
