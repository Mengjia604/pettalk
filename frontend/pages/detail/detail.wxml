<view class="detail-container">
  <view class="post-card">
    <view class="post-header" bindtap="goProfile">
      <image
        wx:if="{{post.avatar}}"
        class="avatar avatar-image"
        src="{{post.avatar}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="avatar">宠</view>
      <view class="user-info">
        <view class="nickname">{{post.nickname || '用户'}}</view>
        <view class="meta-line">
          <text class="time">{{post.createdAt || '刚刚'}}</text>
          <text wx:if="{{post.channelName}}" class="channel-tag">#{{post.channelName}}</text>
        </view>
      </view>
      <view
        wx:if="{{userId && post.userId === userId}}"
        class="post-more"
        catchtap="onPostMore"
      >
        <view class="post-more-dot"></view>
        <view class="post-more-dot"></view>
        <view class="post-more-dot"></view>
      </view>
    </view>

    <view class="post-content" wx:if="{{post.content}}">{{post.content}}</view>

    <view class="image-grid" wx:if="{{post.images && post.images.length > 0}}">
      <image
        wx:for="{{post.images}}"
        wx:for-item="img"
        wx:key="*this"
        src="{{img}}"
        mode="aspectFill"
        class="grid-image"
        bindtap="previewImage"
        data-urls="{{post.images}}"
        data-current="{{img}}"
      />
    </view>

    <view class="post-footer">
      <view class="stat like {{post.liked ? 'active' : ''}}" bindtap="toggleLike">
        {{post.liked ? '已赞' : '点赞'}} {{post.likeCount || 0}}
      </view>
      <text class="stat">评论 {{post.commentCount || 0}}</text>
    </view>
  </view>

  <view class="comment-section">
    <view class="comment-title">全部评论</view>
    <view class="empty-comment" wx:if="{{!comments || comments.length === 0}}">
      还没有评论，快来抢沙发吧～
    </view>
  </view>
</view>

<view class="bottom-input-bar">
  <input class="comment-input" placeholder="说点什么..." />
  <button class="send-btn" size="mini" hover-class="btn-hover">发送</button>
  <button class="share-btn" size="mini" open-type="share" hover-class="share-hover">转发</button>
</view>
