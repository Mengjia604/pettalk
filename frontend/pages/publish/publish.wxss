.container {
  padding: 24rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #fff;
  min-height: 100vh;
}

.content-input {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  line-height: 1.6;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.pet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.pet-label {
  font-size: 28rpx;
  color: #555;
}

.picker-value {
  color: #4a90e2;
  font-size: 28rpx;
}

.picker-empty {
  color: #A8AEB6;
}

.channel-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 8rpx 0;
  font-size: 23rpx;
  color: #9AA0A6;
}

.channel-hint-link {
  color: #F97316;
  font-weight: 600;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 32rpx;
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #aaa;
}

.plus {
  font-size: 60rpx;
}

.upload-tip {
  margin-top: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.submit-btn {
  padding: 10rpx 0;
  margin-top: 60rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff !important;
  background: linear-gradient(135deg, #ff9a44, #fc6076) !important;
  border: none;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 20rpx rgba(252, 96, 118, 0.3);
}

.btn-hover {
  opacity: 0.9;
  transform: scale(0.95);
  box-shadow: 0 4rpx 10rpx rgba(252, 96, 118, 0.3);
}

.cat-deco {
  position: fixed;
  right: -30rpx;
  bottom: -60rpx;
  z-index: 0;
  width: 240rpx;
  height: 230rpx;
  pointer-events: none;
}
