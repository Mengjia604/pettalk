<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <image
      wx:if="{{selected === index}}"
      class="tab-paw"
      src="/images/paw.png"
      mode="aspectFit"
    ></image>
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
