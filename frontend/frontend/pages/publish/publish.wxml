<view class="container">
  <textarea
    class="content-input"
    placeholder="分享你和宠物的日常..."
    maxlength="1000"
    value="{{content}}"
    bindinput="onContentInput"
  />

  <view class="image-grid">
    <block wx:for="{{images}}" wx:key="*this">
      <view class="image-item">
        <image src="{{item}}" mode="aspectFill" />
        <view class="remove-btn" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
    </block>
    <view wx:if="{{images.length < 9}}" class="add-btn" bindtap="chooseImage">
      <text class="plus">+</text>
    </view>
  </view>

  <!-- 修改后的发布按钮，加入 hover-class 质感 -->
  <button
    class="submit-btn"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="submit"
    hover-class="btn-hover"
  >
    {{submitting ? '发布中...' : '发布'}}
  </button>

  <image class="cat-deco" src="/images/cat.png" mode="aspectFit"></image>
</view>