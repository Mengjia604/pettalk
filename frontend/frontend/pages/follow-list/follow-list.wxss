page { background: #f5f5f5; }
.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 30rpx; color: #666; }
.tab.active { color: #4a90e2; font-weight: bold; border-bottom: 4rpx solid #4a90e2; }

.list-container { padding: 16rpx; }
.user-item { display: flex; align-items: center; background: #fff; padding: 24rpx; border-radius: 16rpx; margin-bottom: 16rpx; }
.avatar { width: 90rpx; height: 90rpx; border-radius: 50%; background: #4a90e2; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; margin-right: 24rpx; }
.info { flex: 1; }
.name { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.bio { font-size: 24rpx; color: #999; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.status-text { text-align: center; color: #999; font-size: 26rpx; padding: 30rpx 0; }