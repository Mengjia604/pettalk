page {
  background: #f5f5f5;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #f7780a, #ffc31e);
  padding: 60rpx 40rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #74ebd5 0%, #9face6 100%);
  color:#fff;
  font-size: 50rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.stats-row {
  display: flex;
  width: 100%;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.label {
  font-size: 24rpx;
  opacity: 0.8;
}

/* Tab 栏 */
.tabs {
  background: #fff;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.tab {
  padding: 30rpx 60rpx;
  font-size: 32rpx;
  color: #666;
}

.tab.active {
  color: #4a90e2;
  font-weight: bold;
  border-bottom: 6rpx solid #4a90e2;
}

/* 动态列表 (复用之前的卡片样式) */
.feed-list {
  padding: 0 20rpx 40rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.post-content {
  font-size: 30rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.grid-image {
  width: 200rpx;
  height: 200rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.stats {
  display: flex;
  gap: 24rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 100rpx;
}