<view class="profile-container">
  <!-- 1. 顶部个人资料卡片 -->
  <view class="header-card">
    <view class="user-info">
      <view class="avatar">用</view> <!-- 之后换成真实头像 -->
      <view class="nickname">用户 1</view>
    </view>
    
    <!-- 数据统计：关注、粉丝、动态数 (目前先用0占位，等3号接口) -->
    <view class="stats-row">
      <view class="stat-item" bindtap="goFollowList" data-type="following">
        <text class="num">0</text><text class="label">关注</text>
      </view>
      <view class="stat-item" bindtap="goFollowList" data-type="followers">
        <text class="num">0</text><text class="label">粉丝</text>
      </view>
      <view class="stat-item">
        <text class="num">{{list.length}}</text>
        <text class="label">动态</text>
      </view>
    </view>
  </view>

  <!-- 2. Tab 切换栏 (目前只有一项) -->
  <view class="tabs">
    <view class="tab active">我的动态</view>
  </view>

  <!-- 3. 我的动态列表 -->
  <view class="feed-list">
    <view wx:for="{{list}}" wx:key="id" class="post-card" bindtap="goDetail" data-id="{{item.id}}">
      <!-- 文字内容 -->
      <view class="post-content" wx:if="{{item.content}}">{{item.content}}</view>
      
      <!-- 图片九宫格 -->
      <view class="image-grid" wx:if="{{item.images && item.images.length > 0}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          class="grid-image"
        />
      </view>
      
      <!-- 底部时间与点赞 -->
      <view class="post-footer">
        <text class="time">{{item.createdAt}}</text>
        <view class="stats">
          <text class="stat">👍 {{item.likeCount || 0}}</text>
          <text class="stat">💬 {{item.commentCount || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">
      你还没有发布过动态哦～
    </view>
  </view>
</view>