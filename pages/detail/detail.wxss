.detail-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.post,
.comments {
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.author {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar,
.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
}

.nickname {
  flex: 1;
  font-weight: 600;
}

.content {
  display: block;
  margin-top: 24rpx;
  line-height: 1.7;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #eee;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  color: #888;
  font-size: 26rpx;
}

.comment {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-body {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.comment-nickname {
  color: #666;
  font-size: 26rpx;
}

.comment-content {
  margin-top: 8rpx;
}

.empty {
  display: block;
  padding: 30rpx 0;
  color: #999;
  text-align: center;
}

.comment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}

.comment-input {
  flex: 1;
  height: 66rpx;
  padding: 0 20rpx;
  border-radius: 33rpx;
  background: #f2f2f2;
}
